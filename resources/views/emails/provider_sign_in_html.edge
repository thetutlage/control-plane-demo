@emailLayout({ title, organizationName })
  <mj-section>
    <mj-column>
      <mj-text mj-class="title">You sign in with your company account</mj-text>
      <mj-spacer height="24px" />
      <mj-text mj-class="text">
        An admin at
        {{ organizationName }}
        set you up to sign in to its apps with your company account. On the sign-in page, choose "Continue with your company account".
      </mj-text>
      <mj-spacer height="16px" />
      <mj-text mj-class="help">
        There is no password to set, and a password you had here before no longer works.
      </mj-text>
      <mj-spacer height="16px" />
    </mj-column>
  </mj-section>
@end
