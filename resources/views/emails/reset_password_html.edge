@emailLayout({ title, organizationName })
  <mj-section>
    <mj-column>
      <mj-text mj-class="title">Need a new password?</mj-text>
      <mj-spacer height="24px" />
      <mj-text mj-class="text">
        Someone asked to reset the password you sign in to
        {{ organizationName }}
        with. If that was you, set a new one here:
      </mj-text>
      <mj-spacer height="16px" />
      <mj-button href="{{ link }}">Reset your password</mj-button>
      <mj-spacer height="16px" />
      <mj-text mj-class="help">
        The link works once, for 1 hour. If you didn't ask for it, ignore this email and your password stays as it is.
      </mj-text>
      <mj-spacer height="16px" />
    </mj-column>
  </mj-section>
@end
