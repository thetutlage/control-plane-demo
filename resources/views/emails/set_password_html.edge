@emailLayout({ title, organizationName })
  <mj-section>
    <mj-column>
      <mj-text mj-class="title">Set your password for {{ organizationName }}</mj-text>
      <mj-spacer height="24px" />
      <mj-text mj-class="text">
        An admin at
        {{ organizationName }}
        set you up to sign in to its apps with your email and a password. Choose your password to get started:
      </mj-text>
      <mj-spacer height="16px" />
      <mj-button href="{{ link }}">Set your password</mj-button>
      <mj-spacer height="16px" />
      <mj-text mj-class="help">
        The link works once, for 3 days. After that, use "Forgot password?" on the sign-in page to get a new one.
      </mj-text>
      <mj-spacer height="16px" />
    </mj-column>
  </mj-section>
@end
