{{--
  The frame of every email: MJML, compiled to HTML when the mail is sent.
  The footer names the organization the email is sent for.
--}}
@mjml()
  <mjml>
    <mj-head>
      <mj-preview>{{ title }}</mj-preview>
      <mj-title>{{ title }}</mj-title>
      <mj-attributes>
        <mj-text padding="0" color="#202020" />
        <mj-divider padding="0" border-width="1px" border-color="#dedede" />
        <mj-button padding="0" align="left" background-color="#202020" color="#ffffff" border-radius="6px" />
        <mj-class name="title" font-size="24px" font-weight="600" line-height="30px" />
        <mj-class name="text" font-size="16px" line-height="22px" />
        <mj-class name="help" font-size="14px" line-height="20px" color="#646464" />
        <mj-class name="footer" font-size="13px" line-height="18px" color="#8d8d8d" />
        <mj-all font-family="Arial, sans-serif" />
      </mj-attributes>
    </mj-head>
    <mj-body>
      {{{ await $slots.main() }}}
      <mj-section>
        <mj-column>
          <mj-divider />
          <mj-spacer height="15px" />
          <mj-text mj-class="footer">
            Sent by {{ brandName }} for {{ organizationName }}.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-body>
  </mjml>
@end
