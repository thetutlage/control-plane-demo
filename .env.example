# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (see compose.yaml)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=control_plane
DB_PASSWORD=control_plane
DB_DATABASE=control_plane

# Mail (Mailpit in compose.yaml; read it at http://localhost:8025)
MAIL_MAILER=smtp
MAIL_FROM_NAME=Backlit
MAIL_FROM_ADDRESS=no-reply@backlit.test
SMTP_HOST=localhost
SMTP_PORT=1025